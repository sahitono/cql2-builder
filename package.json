{
  "name": "cql2-builder",
  "type": "module",
  "version": "0.1.0",
  "description": "Type-safe CQL2 JSON builder",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "bumpp": "^10.0.0",
    "cql2-filters-parser": "^0.9.14",
    "eslint": "^9.0.0",
    "geojson": "^0.5.0",
    "taze": "^21.3.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
