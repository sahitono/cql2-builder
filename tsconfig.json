{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src",
    "test",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
